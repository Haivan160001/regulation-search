# --- Reg-Search ---
chroma_db/
data/uploads/*
!data/uploads/.gitkeep
*.log

# --- Nicht ins oeffentliche Repo -------------------------------------------
# Arbeitsnotizen, Referenzbilder, Demofilm und dessen Werkzeuge. Das Repo
# enthaelt den lauffaehigen Stand, nicht seine Entstehung.
docs/

# Medien- und Aufnahme-Artefakte, unabhaengig vom Ablageort
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.srt
*.vtt

# Regelungsdokumente nie versehentlich einchecken (UNECE-PDFs, Entwuerfe).
# Die mitgelieferten Schriften sind davon nicht betroffen.
*.pdf
*.docx

