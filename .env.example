# -----------------------------------------------------------------------------
# Reg-Search - optionale Umgebungsvariablen
# Kopieren nach ".env" und anpassen (oder direkt als Systemvariablen setzen).
# -----------------------------------------------------------------------------

# Ollama
REG_SEARCH_OLLAMA_URL=http://localhost:11434
REG_SEARCH_LLM_MODEL=qwen2.5:14b
REG_SEARCH_LLM_TEMPERATURE=0.1
REG_SEARCH_NUM_CTX=8192
REG_SEARCH_NUM_PREDICT=1024
REG_SEARCH_KEEP_ALIVE=30m

# Modelle / Devices  (cuda | cpu | auto)
REG_SEARCH_EMBEDDING_MODEL=BAAI/bge-m3
# Reranker: sprachabhaengig! Siehe README "Reranker nach Sprache waehlen".
#   Deutsch / Englisch / gemischt -> BAAI/bge-reranker-large   (Default)
#   ja/ko/ar/slawisch             -> BAAI/bge-reranker-v2-m3
#   < 8 GB VRAM                   -> BAAI/bge-reranker-base
REG_SEARCH_RERANKER_MODEL=BAAI/bge-reranker-large
# Modellcode von HuggingFace ausfuehren (noetig fuer mxbai/jina/gte-Reranker)
REG_SEARCH_TRUST_REMOTE_CODE=0
REG_SEARCH_DEVICE=auto
REG_SEARCH_FP16=1

# Retrieval
REG_SEARCH_TOP_K=20
REG_SEARCH_TOP_N=5
REG_SEARCH_CHUNK_SIZE=1200
REG_SEARCH_CHUNK_OVERLAP=150

# Pfade
REG_SEARCH_CHROMA_DIR=./chroma_db
REG_SEARCH_COLLECTION=unece_regulations

# Optional: HuggingFace-Cache umleiten (grosse Modelle!)
# HF_HOME=D:/hf-cache
